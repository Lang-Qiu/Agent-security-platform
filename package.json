{
  "name": "agent-security-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "npm run test:all",
    "test:all": "npm run test:repo && npm run test:shared && npm run test:engine:sandbox && npm run test:backend && npm run test:frontend",
    "test:repo": "node --experimental-strip-types --experimental-test-isolation=none --test tests/repository/root-test-entry.spec.ts tests/repository/frontend-formatting-boundary.spec.ts tests/repository/track1-scenario-matrix.spec.ts tests/repository/track1-case-set.spec.ts tests/repository/track1-attack-replay.spec.ts tests/repository/track1-monitor-plugin.spec.ts tests/repository/track1-base-filter.spec.ts tests/repository/track1-supervision-ui.spec.ts tests/repository/track1-openclaw-manifest.spec.ts tests/repository/track1-openclaw-plugin.spec.ts tests/repository/track1-campaign-backend.spec.ts tests/repository/track1-campaign-ui.spec.ts tests/repository/track1-evidence-pack.spec.ts tests/repository/track1-review-demo-content.spec.ts tests/repository/track1-review-demo-ui.spec.ts tests/repository/fofa-six-step-minimal.spec.ts tests/repository/fofa-api-task-scan.spec.ts tests/repository/fofa-task-batch-report.spec.ts tests/repository/fofa-mainline-portscan.spec.ts tests/repository/fofa-portscan-workflow.spec.ts tests/repository/asset-scan-bridge.execution-context.spec.ts tests/repository/asset-scan-runtime.interruption-reason.spec.ts",
    "test:shared": "node --experimental-strip-types --experimental-test-isolation=none --test shared/tests/task-contract.spec.ts shared/tests/api-response.contract.spec.ts shared/tests/result-contract.spec.ts shared/tests/sandbox-contract.spec.ts shared/tests/supervision-contract.spec.ts shared/tests/campaign-supervision-contract.spec.ts shared/tests/campaign-ingest-contract.spec.ts",
    "test:engine:sandbox": "node --experimental-strip-types --experimental-test-isolation=none --test engines/sandbox/tests/simulated-tool-contract.spec.ts engines/sandbox/tests/simulated-tool-executor.spec.ts engines/sandbox/tests/attack-replay-loader.spec.ts engines/sandbox/tests/attack-replay-compiler.spec.ts engines/sandbox/tests/attack-replay-entrypoints.spec.ts engines/sandbox/tests/attack-monitor-contract.spec.ts engines/sandbox/tests/attack-monitor-session.spec.ts engines/sandbox/tests/attack-monitor-observed-session.spec.ts engines/sandbox/tests/attack-monitor-replay-adapter.spec.ts engines/sandbox/tests/attack-monitor-demo.spec.ts engines/sandbox/tests/base-filter-contract.spec.ts engines/sandbox/tests/base-filter-evaluator.spec.ts engines/sandbox/tests/base-filter-provider.spec.ts engines/sandbox/tests/base-filter-evaluation.spec.ts",
    "test:backend": "node --experimental-strip-types --experimental-test-isolation=none --test backend/tests/task-center.service.spec.ts backend/tests/task-engine.service.spec.ts backend/tests/asset-scan.engine-client.spec.ts backend/tests/supervision-projector.spec.ts backend/tests/supervision-service.spec.ts backend/tests/supervision-controller.spec.ts backend/tests/campaign-repository.spec.ts backend/tests/campaign-ingest.service.spec.ts backend/tests/campaign-ingest.controller.spec.ts backend/tests/runtime-dependencies.spec.ts backend/tests/campaign-projector.spec.ts backend/tests/campaign-supervision.service.spec.ts backend/tests/main.spec.ts tests/integration/backend-task-center.api.spec.ts tests/integration/backend-supervision.api.spec.ts tests/integration/backend-campaign-ingest.api.spec.ts",
    "test:engine:asset-scan": "node --experimental-strip-types --experimental-test-isolation=none --test tests/repository/fofa-six-step-minimal.spec.ts engines/asset-scan/tests/risk-classification.spec.ts engines/asset-scan/tests/scanners/gitleaks-adapter.spec.ts engines/asset-scan/tests/scanners/trivy-adapter.spec.ts engines/asset-scan/tests/scanners/scanner-runner.spec.ts engines/asset-scan/tests/scanners/version-check.spec.ts",
    "test:integration:openclaw": "node --experimental-strip-types --experimental-test-isolation=none --test integrations/openclaw/tests/plugin-contract.spec.ts integrations/openclaw/tests/campaign-context.spec.ts integrations/openclaw/tests/ingest-client.spec.ts integrations/openclaw/tests/plugin-hooks.spec.ts integrations/openclaw/tests/plugin-runtime-probe.spec.ts",
    "test:frontend": "npm run test --prefix frontend",
    "demo:track1:openclaw": "node --experimental-strip-types scripts/track1/run-openclaw-campaign.ts",
    "test:track1:openclaw:unit": "node --experimental-strip-types --experimental-test-isolation=none --test tests/track1/openclaw-preflight.spec.ts tests/track1/case-prompt.spec.ts tests/track1/openclaw-command.spec.ts tests/track1/openclaw-campaign-runner.spec.ts tests/track1/openclaw-campaign-retry.spec.ts tests/track1/campaign-runner-ports.spec.ts tests/track1/campaign-entrypoint.spec.ts tests/track1/openclaw-offline-runtime.spec.ts tests/repository/track1-openclaw-runtime-config.spec.ts tests/repository/track1-compose.spec.ts",
    "test:track1:openclaw": "npm run test:integration:openclaw && npm run test:track1:openclaw:unit",
    "test:track1:report": "node --experimental-strip-types --experimental-test-isolation=none --test tests/track1/report-projector.spec.ts tests/track1/evidence-manifest.spec.ts tests/track1/markdown-report.spec.ts tests/track1/evidence-capture.spec.ts tests/track1/pdf-builder.spec.ts tests/track1/evidence-pipeline.spec.ts tests/track1/report-fixture-e2e.spec.ts",
    "test:track1:report:docker": "node --experimental-strip-types scripts/track1/build-evidence-images.ts",
    "test:track1:acceptance": "node --experimental-strip-types --experimental-test-isolation=none --test tests/track1/openclaw-credentialed-harness.spec.ts tests/track1/acceptance-validator.spec.ts tests/track1/baseline-promotion.spec.ts",
    "test:track1:openclaw:e2e": "node --experimental-strip-types --experimental-test-isolation=none --test tests/track1/openclaw-credentialed-e2e.spec.ts",
    "track1:evidence:fixture": "node --experimental-strip-types scripts/track1/build-fixture-evidence.ts",
    "report:track1": "node --experimental-strip-types scripts/track1/build-security-risk-report.ts",
    "run:fofa:six-step:minimal": "node --experimental-strip-types scripts/dev/intel/fofa-six-step-minimal.ts",
    "run:fofa:api:task-scan": "node --experimental-strip-types scripts/dev/intel/fofa-api-task-scan.ts",
    "run:fofa:task-batch-report": "node --experimental-strip-types scripts/dev/intel/fofa-task-batch-report.ts",
    "run:fofa:mainline:portscan": "node --experimental-strip-types scripts/dev/intel/fofa-mainline-portscan.ts"
  },
  "dependencies": {
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "ajv": "^8.20.0",
    "playwright-core": "1.60.0"
  }
}
