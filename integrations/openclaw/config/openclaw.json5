{
  // Track 1 OpenClaw Gateway Configuration
  // REQ-T1-DEMO-010: minimal valid config for controlled research runtime
  // Based on OpenClaw 2026.6.10 schema
  //
  // Tool restrictions (read_file, write_file, send_email, call_api only) are
  // enforced by the agent-security-track1 plugin, not this config file.
  // The plugin intercepts all tool calls and blocks unauthorized tools.
  //
  // Agent definitions (three Track 1 agents with fixed IDs) are registered
  // via the plugin, not through this gateway config.

  gateway: {
    port: 19001
  },

  plugins: {
    load: {
      paths: [
        "/usr/local/lib/node_modules/@agent-security-platform/openclaw-integration"
      ]
    },
    entries: {
      "agent-security-track1": {
        config: {
          ingestEndpoint: "http://backend:3001/internal/track1/campaigns",
          ingestToken: "${TRACK1_INGEST_TOKEN}"
        }
      }
    }
  }
}
