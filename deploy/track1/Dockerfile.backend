# Track 1 Backend - Minimal implementation for Phase 4 integration
FROM node:22.19.0-bookworm-slim@sha256:4a4884e8a44826194dff92ba316264f392056cbe243dcc9fd3551e71cea02b90

WORKDIR /app

# Install express
RUN npm install express@4.21.2

# Copy minimal backend server
COPY deploy/track1/minimal-backend.js /app/server.js

EXPOSE 3000 3001
CMD ["node", "server.js"]
