# Track 1 Backend - Placeholder for Phase 5/6
FROM node:22.19.0-bookworm-slim@sha256:4a4884e8a44826194dff92ba316264f392056cbe243dcc9fd3551e71cea02b90

WORKDIR /app

# Phase 4 scope: skeleton service with public + internal health endpoints
RUN npm install express@4.21.2

RUN echo 'const express = require("express"); \
const app = express(); \
app.get("/health", (req, res) => res.json({ status: "ok", port: "public" })); \
app.listen(3000, () => console.log("Backend public API on 3000")); \
const internal = express(); \
internal.get("/health", (req, res) => res.json({ status: "ok", port: "internal" })); \
internal.listen(3001, () => console.log("Backend internal ingest on 3001"));' > server.js

EXPOSE 3000 3001
CMD ["node", "server.js"]
