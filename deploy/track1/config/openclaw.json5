{
  // OpenClaw Gateway Configuration for Track 1 Phase 4
  // Enables conversation-level hook access for plugin monitoring

  "wizard": {
    "lastRunAt": "2026-07-03T06:00:00.000Z",
    "lastRunVersion": "2026.6.10",
    "lastRunCommand": "gateway",
    "lastRunMode": "local"
  },

  // Model configuration - use environment variables for security
  "models": {
    "mode": "merge",
    "providers": {
      "anthropic": {
        "baseUrl": "https://api.anthropic.com/v1",
        "apiKey": "${ANTHROPIC_API_KEY}",
        "api": "anthropic",
        "models": [
          {
            "id": "claude-opus-4-20250514",
            "name": "Claude Opus 4",
            "reasoning": true,
            "input": ["text", "images"],
            "contextWindow": 200000,
            "maxTokens": 16384
          }
        ]
      }
    }
  },

  // Gateway authentication
  "gateway": {
    "auth": {
      "tokens": {
        "${OPENCLAW_GATEWAY_TOKEN}": {
          "scope": "full",
          "description": "Track 1 campaign runner token"
        }
      }
    },
    "hooks": {
      "allowConversationAccess": true,
      "enabled": [
        "llm_input",
        "llm_output",
        "tool_use_before",
        "tool_use_after"
      ]
    }
  },

  // Plugin configuration
  "plugins": {
    "agent-security-track1": {
      "enabled": true,
      "path": "/app/integrations/openclaw",
      "config": {
        "ingestBaseUrl": "${TRACK1_INGEST_BASE_URL}",
        "ingestToken": "${TRACK1_INGEST_TOKEN}",
        "mode": "monitor"
      }
    }
  },

  // Logging
  "logging": {
    "level": "info",
    "format": "json",
    "hooks": true,
    "modelCalls": true
  }
}
