# Track 1 OpenClaw Runtime Image
# REQ-T1-DEMO-010: digest-pinned base with exact lockfile dependencies

# Base: node:22.19.0-bookworm-slim with immutable digest
FROM node:22.19.0-bookworm-slim@sha256:4a4884e8a44826194dff92ba316264f392056cbe243dcc9fd3551e71cea02b90

# Install system dependencies required for OpenClaw
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      git && \
    rm -rf /var/lib/apt/lists/*

# Create application directory
WORKDIR /app

# Copy package files for dependency installation
COPY package.json package-lock.json ./

# Install exact dependencies from lockfile
RUN npm ci --omit=dev --ignore-scripts

# Install OpenClaw exact version globally
RUN npm install --global openclaw@2026.6.10

# Build and install Phase 3 plugin
COPY integrations/openclaw/package.json /app/plugin/package.json
COPY integrations/openclaw/openclaw.plugin.json /app/plugin/openclaw.plugin.json
COPY integrations/openclaw/src /app/plugin/src
COPY integrations/openclaw/scripts /app/plugin/scripts

# Install plugin dependencies and build
WORKDIR /app/plugin
RUN npm install && npm run build

# Pack and install plugin globally
RUN npm pack && npm install --global agent-security-platform-openclaw-integration-*.tgz

# Clean up plugin build artifacts and devDependencies to reduce image size
RUN rm -rf /app/plugin/node_modules /app/plugin/src /app/plugin/scripts

# Copy OpenClaw configuration
WORKDIR /app
COPY integrations/openclaw/config/ /app/config/

# Create tmpfs mount points
RUN mkdir -p /run/track1/workspace /tmp/openclaw/sessions /run/track1/messages

# Non-root user for runtime
RUN useradd -r -u 1001 -s /sbin/nologin -m openclaw && \
    chown -R openclaw:openclaw /app /run/track1 /tmp/openclaw

USER openclaw

# Verify OpenClaw installation
RUN openclaw --version

# Verify plugin installation (requires minimal config with ingest token)
RUN mkdir -p ~/.openclaw && \
    echo '{"plugins":{"load":{"paths":["/usr/local/lib/node_modules/@agent-security-platform/openclaw-integration"]},"entries":{"agent-security-track1":{"config":{"ingestEndpoint":"http://localhost:3001","ingestToken":"verify"}}}}}' > ~/.openclaw/openclaw.json && \
    openclaw plugins list --json 2>&1 | grep -q '"id": "agent-security-track1"' && \
    rm ~/.openclaw/openclaw.json

# Default command (override in compose)
CMD ["openclaw", "agent", "--help"]
