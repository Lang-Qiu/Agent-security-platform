# Track 1 Phase 4 Runtime - Environment Variables
# Copy this file to .env and fill in your actual values

# OpenClaw Model Configuration
OPENCLAW_MODEL_BASE_URL=https://api.anthropic.com/v1
OPENCLAW_MODEL_API_KEY=your-anthropic-api-key-here
OPENCLAW_MODEL_ID=anthropic/claude-sonnet-5

# Backend Authentication
TRACK1_INGEST_TOKEN=your-secure-token-here

# OpenClaw Gateway Token (should match backend's expected token)
OPENCLAW_GATEWAY_TOKEN=gateway-secure-token-here

# Optional: Backend URL override (defaults to http://localhost:3001)
# TRACK1_BACKEND_URL=http://backend:3001

# Optional: OpenClaw Gateway URL override (defaults to http://openclaw:3002)
# OPENCLAW_GATEWAY_URL=http://openclaw:3002
